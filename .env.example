# Personal values interpolated as ${VAR} into config.toml at load time.
# Copy to .env and fill in.

# Google Drive roots to index, separated by ":" (os.pathsep)
DOCS_DIRS=/path/to/drive_pro:/path/to/drive_perso

# Accounts named in the tool descriptions
MYELINK_EMAIL=pro@example.com
PERSONAL_EMAIL=perso@example.com

# OAuth "Desktop" client for the calendar MCP servers
GOOGLE_OAUTH_CREDENTIALS=/path/to/google-oauth.json

# Melious API (router + critical agent)
MELIOUS_DONA_API_KEY=
